generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id String @id @default(uuid())

  firstName  String
  lastName   String
  middleName String?

  title   String?
  summary String?

  email String  @unique
  phone String?

  location String?
  website  String?

  experiences Experience[]
  education   Education[]
  skills      ProfileSkill[]
  languages   Language[]

  recommendations Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
}

model Experience {
  id String @id @default(uuid())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  company  String
  position String

  startYear Int?
  endYear   Int?

  location    String?
  description String?

  highlights String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([profileId, startYear])
}

model Education {
  id String @id @default(uuid())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  institution String
  faculty     String?
  degree      String?

  startYear Int?
  endYear   Int?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([profileId, startYear])
}

model Skill {
  id String @id @default(uuid())

  name String @unique

  category    SkillCategory?
  proficiency SkillProficiency?

  profiles ProfileSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfileSkill {
  profileId String
  skillId   String

  profile Profile @relation( fields: [profileId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  note String?

  createdAt DateTime @default(now())

  @@id([profileId, skillId])
  @@index([skillId])
}

model Language {
  id String @id @default(uuid())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name  String
  level LanguageLevel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, name])
  @@index([profileId])
}

model Recommendation {
  id String @id @default(uuid())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  authorName String
  authorRole String?
  authorOrg  String?

  content String
  contact String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

enum LanguageLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

enum SkillCategory {
  PROGRAMMING
  FRAMEWORK
  DATABASE
  DEVOPS
  CLOUD
  FRONTEND
  BACKEND
  MOBILE
  TESTING
  TOOLS
  SOFT_SKILL
  OTHER
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}
